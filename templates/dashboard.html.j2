<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Stablecoin Teams — {{ target_chain }}</title>
<style>
  /* Dark is the default: this is a data tool, and the reference class (Bloomberg,
     Linear, Datadog, Dune) ships dark. Light is a deliberate alternative, not an
     afterthought - both palettes are stepped for their own surface. */
  :root, :root[data-theme="dark"] {
    color-scheme: dark;
    --bg:        #0d0d0d;
    --panel:     #141413;
    --raised:    #1a1a19;
    --line:      #262625;
    --line-soft: #1e1e1d;
    --ink:       #f2f2ef;
    --ink-2:     #a3a29c;
    --ink-3:     #6f6e69;
    --usdc:      #3987e5;
    --usdt:      #d95926;
    --usde:      #199e70;
    --good:      #0ca30c;
    --warn:      #fab219;
    --serious:   #ec835a;
    --gap:       #d03b3b;
    --up:        #35c759;
    --down:      #e66767;
    --hover:     rgba(255,255,255,0.035);
    --sel:       rgba(57,135,229,0.10);
  }
  :root[data-theme="light"] {
    color-scheme: light;
    --bg:        #f7f7f5;
    --panel:     #ffffff;
    --raised:    #fcfcfb;
    --line:      #e3e2dc;
    --line-soft: #edece7;
    --ink:       #14140f;
    --ink-2:     #5c5b55;
    --ink-3:     #8e8d86;
    --usdc:      #2a78d6;
    --usdt:      #eb6834;
    --usde:      #1baf7a;
    --up:        #006300;
    --down:      #c02c2c;
    --hover:     rgba(0,0,0,0.028);
    --sel:       rgba(42,120,214,0.08);
  }

  *, *::before, *::after { box-sizing: border-box; }
  html, body { height: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 13px/1.4 ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  /* Every figure is monospaced so columns align optically, not just numerically.
     This is the single biggest thing that makes a table read as an instrument
     rather than a web page. */
  .num { font-family: ui-monospace, "SF Mono", "Cascadia Mono", Menlo, Consolas, monospace;
         font-variant-numeric: tabular-nums; letter-spacing: -0.01em; }

  a { color: inherit; }
  button { font: inherit; color: inherit; }

  /* ---------- frame ---------- */
  .app { display: flex; flex-direction: column; height: 100vh; }

  .bar {
    display: flex; align-items: center; gap: 14px;
    padding: 0 14px; height: 44px; flex: none;
    background: var(--panel); border-bottom: 1px solid var(--line);
  }
  .brand { display: flex; align-items: baseline; gap: 9px; min-width: 0; }
  .brand b { font-size: 13px; font-weight: 600; letter-spacing: -0.005em; }
  .brand span { color: var(--ink-3); font-size: 11.5px; white-space: nowrap;
                overflow: hidden; text-overflow: ellipsis; }
  .bar .spacer { flex: 1; }

  .ghost {
    background: none; border: 1px solid var(--line); border-radius: 3px;
    padding: 3px 8px; font-size: 11.5px; color: var(--ink-2); cursor: pointer;
    white-space: nowrap;
  }
  .ghost:hover { background: var(--hover); color: var(--ink); }
  .ghost[aria-pressed="true"] { background: var(--sel); border-color: var(--usdc);
                                color: var(--ink); }

  /* ---------- readout: one line, not a grid of cards ---------- */
  .readout {
    display: flex; align-items: stretch; flex-wrap: wrap; flex: none;
    background: var(--panel); border-bottom: 1px solid var(--line);
  }
  .stat { padding: 9px 16px; border-right: 1px solid var(--line-soft); min-width: 0; }
  .stat .k { font-size: 11px; color: var(--ink-3); margin-bottom: 2px; white-space: nowrap; }
  .stat .v { font-size: 17px; font-weight: 550; letter-spacing: -0.015em; line-height: 1.15; }
  .stat .v small { font-size: 11.5px; color: var(--ink-3); font-weight: 400;
                   margin-left: 5px; letter-spacing: 0; }
  .stat.wide { flex: 1; border-right: 0; }

  /* asset legend doubles as the composition key for every bar in the table */
  .keys { display: flex; align-items: center; gap: 13px; padding: 9px 16px;
          margin-left: auto; }
  .keys i { width: 8px; height: 8px; border-radius: 2px; display: inline-block;
            margin-right: 5px; vertical-align: 0; }
  .keys span { font-size: 11.5px; color: var(--ink-2); white-space: nowrap; }

  /* chain market context: how big is the pool each team sits in */
  .markets { flex: none; background: var(--panel); border-bottom: 1px solid var(--line);
             padding: 9px 14px; display: grid; gap: 5px 22px;
             grid-template-columns: repeat(auto-fill, minmax(232px, 1fr)); }
  .mk { display: grid; grid-template-columns: 78px 1fr 62px; gap: 9px;
        align-items: center; font-size: 11.5px; }
  .mk .c { color: var(--ink-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mk .v { color: var(--ink-3); text-align: right; }
  .mk.tgt .c { color: var(--ink); font-weight: 550; }

  /* ---------- toolbar ---------- */
  .tools {
    display: flex; align-items: center; gap: 7px; flex-wrap: wrap; flex: none;
    padding: 7px 14px; background: var(--bg); border-bottom: 1px solid var(--line);
  }
  .tools input, .tools select {
    background: var(--raised); color: var(--ink);
    border: 1px solid var(--line); border-radius: 3px;
    padding: 4px 7px; font: inherit; font-size: 12px; height: 26px;
  }
  .tools input:focus, .tools select:focus {
    outline: none; border-color: var(--usdc); background: var(--panel);
  }
  .tools input[type="search"] { width: 190px; }
  .tools input[type="number"] { width: 96px; }
  .tools .sep { width: 1px; height: 18px; background: var(--line); margin: 0 3px; }
  .tools label.chk { display: inline-flex; align-items: center; gap: 5px;
                     font-size: 11.5px; color: var(--ink-2); cursor: pointer; }
  .tools label.chk input { height: auto; }
  .tools .hint { font-size: 11.5px; color: var(--ink-3); }

  /* ---------- table ---------- */
  .scroll { flex: 1; overflow: auto; }
  table { border-collapse: separate; border-spacing: 0; width: 100%; }

  thead th {
    position: sticky; top: 0; z-index: 3;
    background: var(--bg);
    text-align: right; white-space: nowrap; cursor: pointer; user-select: none;
    font-size: 11px; font-weight: 500; color: var(--ink-3);
    padding: 7px 10px; border-bottom: 1px solid var(--line);
  }
  thead th.l { text-align: left; }
  thead th:hover { color: var(--ink); }
  thead th.on { color: var(--ink); }
  thead th .ar { font-size: 8px; margin-left: 3px; vertical-align: 1px; }

  /* 30px rows. Financial users read dense tables; 56px "comfortable" rows would
     show a third as much and make this feel like a marketing page. */
  tbody td {
    padding: 0 10px; height: 30px; text-align: right; white-space: nowrap;
    border-bottom: 1px solid var(--line-soft); font-size: 12.5px;
  }
  tbody td.l { text-align: left; }
  tbody tr.row { cursor: pointer; }
  tbody tr.row:hover td { background: var(--hover); }
  tbody tr.open td { background: var(--sel); }

  .team { display: flex; align-items: center; gap: 7px; min-width: 0; }
  .team .tw { width: 7px; color: var(--ink-3); font-size: 8px; flex: none; }
  .team .nm { font-weight: 500; overflow: hidden; text-overflow: ellipsis;
              max-width: 210px; }
  .team .cat { color: var(--ink-3); font-size: 11px; flex: none; }
  .dim { color: var(--ink-3); }
  .zero { color: var(--ink-3); }

  .flag { font-size: 10px; color: var(--ink-3); border: 1px solid var(--line);
          border-radius: 2px; padding: 0 4px; line-height: 15px; flex: none; }

  .up { color: var(--up); } .down { color: var(--down); }

  /* composition bar: three thin segments, 1px apart, width scaled to the row's
     share of the largest holding in view */
  .bar-cell { width: 108px; }
  .cmp { display: flex; gap: 1px; height: 6px; }
  .cmp i { display: block; border-radius: 1px; }
  .cmp i:first-child { border-top-left-radius: 3px; border-bottom-left-radius: 3px; }
  .cmp i:last-child { border-top-right-radius: 3px; border-bottom-right-radius: 3px; }

  /* status: a dot plus a word. Never colour on its own. */
  .st { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
  .st i { width: 6px; height: 6px; border-radius: 50%; flex: none; }
  .st.deployed i { background: var(--good); }
  .st.listed i { background: var(--warn); }
  .st.mentioned i { background: var(--serious); }
  .st.none i { background: var(--gap); }
  .st.deployed, .st.listed, .st.mentioned { color: var(--ink-3); }
  .st.none { color: var(--ink-2); }

  /* ---------- expanded row ---------- */
  tr.detail > td { padding: 0; background: var(--panel);
                   border-bottom: 1px solid var(--line); }
  .dwrap { padding: 11px 14px 13px 31px; display: flex; gap: 34px; flex-wrap: wrap; }
  .dwrap h4 { margin: 0 0 6px; font-size: 11px; font-weight: 500; color: var(--ink-3); }
  table.sub { border-collapse: collapse; }
  table.sub th { font-size: 10.5px; font-weight: 500; color: var(--ink-3);
                 text-align: right; padding: 0 12px 4px 0; }
  table.sub th:first-child { text-align: left; }
  table.sub td { font-size: 12px; padding: 3px 12px 3px 0; text-align: right;
                 border-top: 1px solid var(--line-soft); }
  table.sub td:first-child { text-align: left; }
  table.sub tr.tgt td { color: var(--ink); font-weight: 550; }
  .facts { font-size: 12px; color: var(--ink-2); max-width: 430px; line-height: 1.6; }
  .facts b { color: var(--ink); font-weight: 550; }
  .facts a { color: var(--usdc); }

  .empty { padding: 56px 16px; text-align: center; color: var(--ink-3); font-size: 13px; }
  .foot { flex: none; padding: 8px 14px; border-top: 1px solid var(--line);
          background: var(--panel); color: var(--ink-3); font-size: 11px;
          display: flex; gap: 16px; flex-wrap: wrap; }

  @media (max-width: 860px) {
    .stat { padding: 8px 12px; }
    .stat .v { font-size: 15px; }
    .team .nm { max-width: 130px; }
    .keys { margin-left: 0; }
    /* The bar is a fixed-height row on desktop; on narrow screens its buttons
       must wrap rather than push past the viewport edge. */
    .bar { height: auto; min-height: 44px; flex-wrap: wrap; gap: 8px;
           padding: 8px 12px; }
    .bar .spacer { flex-basis: 100%; height: 0; }
    .brand span { display: none; }
    .tools input[type="search"] { width: 100%; }
    .tools input[type="number"] { width: 84px; }
  }
</style>
</head>
<body>
<div class="app">

  <div class="bar">
    <div class="brand">
      <b>Stablecoin desk</b>
      <span id="asof">&mdash;</span>
    </div>
    <div class="spacer"></div>
    <button class="ghost" id="preset-prospects" aria-pressed="true">Prospects</button>
    <button class="ghost" id="preset-all">All teams</button>
    <button class="ghost" id="markets-btn" aria-pressed="false">Markets</button>
    <button class="ghost" id="csv">Export</button>
    <button class="ghost" id="theme">Light</button>
  </div>

  <div class="readout" id="readout"></div>
  <div class="markets" id="markets" hidden></div>

  <div class="tools">
    <input id="f-q" type="search" placeholder="Team or category" autocomplete="off" spellcheck="false">
    <span class="sep"></span>
    <input id="f-min" type="number" step="100000" value="500000" title="Minimum total TVL" aria-label="Minimum TVL">
    <span class="hint">to</span>
    <input id="f-max" type="number" step="100000" value="10000000" title="Maximum total TVL" aria-label="Maximum TVL">
    <span class="sep"></span>
    <select id="f-arb" aria-label="{{ target_chain }} status">
      <option value="none" selected>No {{ target_chain }} signal</option>
      <option value="any">Any status</option>
      <option value="not-deployed">Not deployed</option>
      <option value="deployed">Deployed</option>
      <option value="listed">Listed only</option>
      <option value="mentioned">Mentioned</option>
    </select>
    <select id="f-cat" aria-label="Category"><option value="">All categories</option></select>
    <select id="f-chain" aria-label="Chain"><option value="">Any chain</option></select>
    <span class="sep"></span>
    <label class="chk"><input type="checkbox" id="t-wrapped"> wrapped</label>
    <label class="chk"><input type="checkbox" id="t-hasdata" checked> with token data</label>
    <span class="spacer" style="flex:1"></span>
    <span class="hint" id="count"></span>
  </div>

  <div class="scroll">
    <table>
      <thead><tr id="head"></tr></thead>
      <tbody id="body"></tbody>
    </table>
    <div class="empty" id="empty" hidden>Nothing matches these filters.</div>
  </div>

  <div class="foot">
    <span>Balances from DefiLlama protocol adapters, which read each team's contracts directly.</span>
    <span><b style="color:var(--ink-2)">rpc</b> = measured on-chain.</span>
    <span><b style="color:var(--ink-2)">no data</b> = adapter publishes no token split, not a zero balance.</span>
  </div>
</div>

<script id="payload" type="application/json">{{ payload_json|safe }}</script>
<script>
(function () {
  "use strict";

  var DATA = JSON.parse(document.getElementById("payload").textContent);
  var ROWS = DATA.rows;
  var TARGET = DATA.target_chain;
  // Assets are data-driven, so adding a fourth stablecoin in config/tokens.yml
  // flows through to columns, bars, legend and CSV with no change here.
  var ASSETS = DATA.assets || [{key: "usdc", label: "USDC"}, {key: "usdt", label: "USDT"}];

  var STATUS = {deployed: "Deployed", listed: "Listed", mentioned: "Mentioned", none: "No signal"};

  var state = {
    q: "", min: 500000, max: 10000000, arb: "none",
    cat: "", chain: "", wrapped: false, hasdata: true,
    sort: "core", dir: -1, open: {}
  };

  // ---- format ----
  function usd(v) {
    if (v === null || v === undefined) return "—";
    var a = Math.abs(v);
    if (a >= 1e9) return (v / 1e9).toFixed(2) + "B";
    if (a >= 1e6) return (v / 1e6).toFixed(2) + "M";
    if (a >= 1e3) return (v / 1e3).toFixed(0) + "K";
    if (a < 1) return "0";
    return v.toFixed(0);
  }
  function delta(v) {
    if (v === null || v === undefined || Math.abs(v) < 1) return '<span class="zero">—</span>';
    var cls = v > 0 ? "up" : "down";
    return '<span class="' + cls + '">' + (v > 0 ? "+" : "−") + usd(Math.abs(v)) + "</span>";
  }
  function esc(s) {
    return String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;")
      .replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  }
  function assetTotal(r) {
    var t = 0;
    for (var i = 0; i < ASSETS.length; i++) t += r[ASSETS[i].key] || 0;
    return t;
  }
  function coreOf(r) { return assetTotal(r) + (state.wrapped ? r.w : 0); }

  // ---- columns, built from the asset list ----
  var COLS = [{k: "n", label: "Team", cls: "l"}];
  ASSETS.forEach(function (a) { COLS.push({k: a.key, label: a.label, num: true}); });
  COLS.push({k: "core", label: "Total", num: true, strong: true});
  COLS.push({k: "_bar", label: "", cls: "l", nosort: true});
  COLS.push({k: "d7", label: "7d", num: true});
  COLS.push({k: "d30", label: "30d", num: true});
  COLS.push({k: "o", label: "Other", num: true});
  COLS.push({k: "t", label: "TVL", num: true});
  COLS.push({k: "top", label: "Top chain", cls: "l"});
  COLS.push({k: "arb", label: TARGET, cls: "l"});

  function renderHead() {
    document.getElementById("head").innerHTML = COLS.map(function (c) {
      var on = state.sort === c.k;
      return '<th class="' + (c.cls || "") + (on ? " on" : "") + '"' +
        (c.nosort ? ' style="cursor:default"' : ' data-k="' + c.k + '"') + ">" +
        esc(c.label) + (on ? '<span class="ar">' + (state.dir < 0 ? "▼" : "▲") + "</span>" : "") +
        "</th>";
    }).join("");
  }

  // ---- filter / sort ----
  function passes(r) {
    if (state.min && r.t < state.min) return false;
    if (state.max && r.t > state.max) return false;
    if (state.cat && r.c !== state.cat) return false;
    if (state.chain && !(r.ch && r.ch[state.chain])) return false;
    if (state.hasdata && r.st !== "ok" && r.st !== "partial") return false;
    if (state.q) {
      var q = state.q.toLowerCase();
      if (r.n.toLowerCase().indexOf(q) < 0 && r.c.toLowerCase().indexOf(q) < 0) return false;
    }
    var a = state.arb;
    if (a === "none" && r.arb !== "none") return false;
    if (a === "not-deployed" && r.arb === "deployed") return false;
    if (a !== "any" && a !== "none" && a !== "not-deployed" && r.arb !== a) return false;
    return true;
  }

  function sorted(rows) {
    var k = state.sort, d = state.dir;
    return rows.slice().sort(function (x, y) {
      var a = k === "core" ? coreOf(x) : x[k];
      var b = k === "core" ? coreOf(y) : y[k];
      if (a == null) a = -Infinity;
      if (b == null) b = -Infinity;
      if (typeof a === "string" || typeof b === "string") {
        a = String(a).toLowerCase(); b = String(b).toLowerCase();
        return a < b ? -d : a > b ? d : 0;
      }
      return (a - b) * d;
    });
  }

  // ---- render ----
  function compBar(r, scale) {
    var total = assetTotal(r);
    if (!total || !scale) return "";
    var w = Math.max(4, Math.min(100, (total / scale) * 100));
    var segs = ASSETS.map(function (a) {
      var v = r[a.key] || 0;
      if (v <= 0) return "";
      return '<i style="flex:' + ((v / total) * 100).toFixed(2) +
        ';background:var(--' + a.key + ')"></i>';
    }).join("");
    var tip = ASSETS.filter(function (a) { return (r[a.key] || 0) > 0; })
      .map(function (a) { return a.label + " " + usd(r[a.key]); }).join("  ");
    return '<div class="cmp" style="width:' + w.toFixed(1) + '%" title="' + esc(tip) + '">' +
      segs + "</div>";
  }

  function statusFlag(r) {
    if (r.st === "unavailable" || r.st === "not_fetched") return '<span class="flag">no data</span>';
    if (r.st === "partial") return '<span class="flag">partial</span>';
    if (r.st === "too_large") return '<span class="flag">too large</span>';
    if (r.st === "error") return '<span class="flag">failed</span>';
    return "";
  }

  function rowHtml(r, scale) {
    var open = !!state.open[r.k];
    var cells = COLS.map(function (c) {
      if (c.k === "n") {
        return '<td class="l"><div class="team"><span class="tw">' + (open ? "▾" : "▸") +
          '</span><span class="nm">' + esc(r.n) + '</span>' +
          '<span class="cat">' + esc(r.c) + "</span>" + statusFlag(r) + "</div></td>";
      }
      if (c.k === "_bar") return '<td class="l bar-cell">' + compBar(r, scale) + "</td>";
      if (c.k === "core") return '<td class="num"><b>' + usd(coreOf(r)) + "</b></td>";
      if (c.k === "d7" || c.k === "d30") return '<td class="num">' + delta(r[c.k]) + "</td>";
      if (c.k === "t") return '<td class="num dim">' + usd(r.t) + "</td>";
      if (c.k === "o") return '<td class="num">' + (r.o > 0 ? usd(r.o) : '<span class="zero">—</span>') + "</td>";
      if (c.k === "top") return '<td class="l dim">' + esc(r.top || "—") + "</td>";
      if (c.k === "arb") {
        return '<td class="l"><span class="st ' + r.arb + '"><i></i>' + STATUS[r.arb] +
          (r.arb === "deployed" && r.arbTvl > 0 ? ' <span class="num dim">' + usd(r.arbTvl) + "</span>" : "") +
          "</span></td>";
      }
      var v = r[c.k];
      return '<td class="num">' + (v > 0 ? usd(v) : '<span class="zero">—</span>') + "</td>";
    }).join("");

    var html = '<tr class="row' + (open ? " open" : "") + '" data-k="' + esc(r.k) + '">' + cells + "</tr>";
    if (open) html += detail(r);
    return html;
  }

  function detail(r) {
    var list = Object.keys(r.ch || {}).map(function (c) {
      return Object.assign({chain: c}, r.ch[c]);
    }).sort(function (a, b) {
      var s = 0, t = 0;
      ASSETS.forEach(function (x) { s += b[x.key] || 0; t += a[x.key] || 0; });
      return s - t;
    });

    var head = "<tr><th>Chain</th>" +
      ASSETS.map(function (a) { return "<th>" + esc(a.label) + "</th>"; }).join("") +
      "<th>Wrapped</th><th>Other</th></tr>";
    var body = list.map(function (c) {
      return "<tr" + (c.chain === TARGET ? ' class="tgt"' : "") + "><td>" + esc(c.chain) +
        (c.src === "rpc" ? ' <span class="flag">rpc</span>' : "") + "</td>" +
        ASSETS.map(function (a) {
          return '<td class="num">' + ((c[a.key] || 0) > 0 ? usd(c[a.key]) : '<span class="zero">—</span>') + "</td>";
        }).join("") +
        '<td class="num">' + (c.wrapped > 0 ? usd(c.wrapped) : '<span class="zero">—</span>') + "</td>" +
        '<td class="num">' + (c.other > 0 ? usd(c.other) : '<span class="zero">—</span>') + "</td></tr>";
    }).join("");

    var table = list.length
      ? '<div><h4>By chain</h4><table class="sub"><thead>' + head + "</thead><tbody>" + body + "</tbody></table></div>"
      : "";

    var src = r.arbSrc && /^https?:/.test(r.arbSrc)
      ? ' <a href="' + esc(r.arbSrc) + '" target="_blank" rel="noopener noreferrer">source</a>'
      : (r.arbSrc ? ' <span class="dim">(' + esc(r.arbSrc) + ")</span>" : "");

    var facts = '<div class="facts"><h4>Detail</h4>' +
      "<div><b>" + TARGET + ":</b> " + esc(r.arbWhy || "") + src + "</div>" +
      "<div><b>Chains:</b> " + esc((r.chains || []).join(", ") || "—") + "</div>" +
      (r.np > 1 ? "<div><b>Bundled:</b> " + r.np + " protocols</div>" : "") +
      (r.u ? '<div><a href="' + esc(r.u) + '" target="_blank" rel="noopener noreferrer">' +
        esc(r.u.replace(/^https?:\/\//, "").replace(/\/$/, "")) + "</a></div>" : "") +
      "</div>";

    return '<tr class="detail"><td colspan="' + COLS.length + '"><div class="dwrap">' +
      table + facts + "</div></td></tr>";
  }

  function render() {
    var rows = ROWS.filter(passes);
    var scale = rows.reduce(function (m, r) { return Math.max(m, assetTotal(r)); }, 0);
    var view = sorted(rows);

    document.getElementById("body").innerHTML =
      view.map(function (r) { return rowHtml(r, scale); }).join("");
    document.getElementById("empty").hidden = view.length > 0;
    document.getElementById("count").textContent =
      view.length.toLocaleString() + " of " + ROWS.length.toLocaleString() + " teams";

    renderHead();
    readout(rows);
  }

  function readout(rows) {
    var gap = rows.filter(function (r) { return r.arb === "none"; });
    var pot = gap.reduce(function (s, r) { return s + coreOf(r); }, 0);
    var totals = ASSETS.map(function (a) {
      return {label: a.label, key: a.key,
              v: rows.reduce(function (s, r) { return s + (r[a.key] || 0); }, 0)};
    });
    var top = gap.reduce(function (m, r) { return (!m || coreOf(r) > coreOf(m)) ? r : m; }, null);

    var cells = [
      {k: "Off " + TARGET, v: usd(pot), note: gap.length + " teams"},
      {k: "Largest gap", v: top ? usd(coreOf(top)) : "—", note: top ? top.n : ""}
    ];
    totals.forEach(function (t) { cells.push({k: t.label, v: usd(t.v), note: ""}); });

    document.getElementById("readout").innerHTML =
      cells.map(function (c) {
        return '<div class="stat"><div class="k">' + esc(c.k) + '</div>' +
          '<div class="v num">' + esc(c.v) +
          (c.note ? "<small>" + esc(c.note) + "</small>" : "") + "</div></div>";
      }).join("") +
      '<div class="keys">' + ASSETS.map(function (a) {
        return '<span><i style="background:var(--' + a.key + ')"></i>' + esc(a.label) + "</span>";
      }).join("") + "</div>";
  }

  // ---- chain markets ----
  function renderMarkets() {
    var m = DATA.markets || [];
    var max = m.reduce(function (a, x) {
      var t = 0; ASSETS.forEach(function (k) { t += x[k.key] || 0; });
      return Math.max(a, t);
    }, 0);
    document.getElementById("markets").innerHTML = m.map(function (x) {
      var tot = 0; ASSETS.forEach(function (k) { tot += x[k.key] || 0; });
      var w = max ? Math.max(2, (tot / max) * 100) : 0;
      var segs = ASSETS.map(function (k) {
        var v = x[k.key] || 0;
        if (v <= 0 || !tot) return "";
        return '<i style="flex:' + ((v / tot) * 100).toFixed(2) +
          ';background:var(--' + k.key + ')"></i>';
      }).join("");
      var tip = ASSETS.filter(function (k) { return (x[k.key] || 0) > 0; })
        .map(function (k) { return k.label + " " + usd(x[k.key]); }).join("  ");
      return '<div class="mk' + (x.chain === TARGET ? " tgt" : "") + '">' +
        '<span class="c">' + esc(x.chain) + "</span>" +
        '<span><span class="cmp" style="display:flex;width:' + w.toFixed(1) +
          '%" title="' + esc(tip) + '">' + segs + "</span></span>" +
        '<span class="v num">' + usd(tot) + "</span></div>";
    }).join("");
  }
  renderMarkets();

  var mkBtn = document.getElementById("markets-btn");
  mkBtn.addEventListener("click", function () {
    var el = document.getElementById("markets");
    el.hidden = !el.hidden;
    mkBtn.setAttribute("aria-pressed", String(!el.hidden));
  });

  // ---- csv ----
  function exportCsv() {
    var rows = sorted(ROWS.filter(passes));
    var head = ["team", "category", "url"]
      .concat(ASSETS.map(function (a) { return a.label.toLowerCase(); }))
      .concat(["total", "wrapped", "other_stables", "total_tvl", "change_7d", "change_30d",
               "top_chain", "status", "status_tvl", "status_reason", "chains", "token_data"]);
    var lines = [head.join(",")];
    rows.forEach(function (r) {
      var cells = [r.n, r.c, r.u || ""]
        .concat(ASSETS.map(function (a) { return r[a.key] || 0; }))
        .concat([coreOf(r), r.w, r.o, r.t, r.d7 == null ? "" : r.d7,
                 r.d30 == null ? "" : r.d30, r.top || "", r.arb, r.arbTvl,
                 r.arbWhy || "", (r.chains || []).join(" | "), r.st]);
      lines.push(cells.map(function (c) {
        var s = String(c == null ? "" : c);
        return /[",\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
      }).join(","));
    });
    var blob = new Blob([lines.join("\n")], {type: "text/csv;charset=utf-8"});
    var a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = "stablecoin-teams-" + (DATA.generated_at || "").slice(0, 10) + ".csv";
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    setTimeout(function () { URL.revokeObjectURL(a.href); }, 1000);
  }

  // ---- wiring ----
  function opts(id, values) {
    var sel = document.getElementById(id);
    values.forEach(function (v) {
      var o = document.createElement("option");
      o.value = v; o.textContent = v; sel.appendChild(o);
    });
  }
  opts("f-cat", DATA.categories || []);
  opts("f-chain", DATA.chains || []);

  function bind(id, key, fn) {
    var n = document.getElementById(id);
    n.addEventListener(n.tagName === "SELECT" || n.type === "checkbox" ? "change" : "input",
      function () { state[key] = fn ? fn(n) : n.value; render(); });
  }
  bind("f-q", "q");
  bind("f-min", "min", function (n) { return parseFloat(n.value) || 0; });
  bind("f-max", "max", function (n) { return parseFloat(n.value) || Infinity; });
  bind("f-arb", "arb");
  bind("f-cat", "cat");
  bind("f-chain", "chain");
  bind("t-wrapped", "wrapped", function (n) { return n.checked; });
  bind("t-hasdata", "hasdata", function (n) { return n.checked; });

  document.getElementById("head").addEventListener("click", function (e) {
    var th = e.target.closest("th[data-k]");
    if (!th) return;
    var k = th.dataset.k;
    if (state.sort === k) state.dir = -state.dir;
    else { state.sort = k; state.dir = (k === "n" || k === "top" || k === "arb") ? 1 : -1; }
    render();
  });

  document.getElementById("body").addEventListener("click", function (e) {
    if (e.target.closest("a")) return;
    var tr = e.target.closest("tr.row");
    if (!tr) return;
    var k = tr.dataset.k;
    if (state.open[k]) delete state.open[k]; else state.open[k] = true;
    render();
  });

  function preset(which) {
    var f = which === "prospects"
      ? {min: 500000, max: 10000000, arb: "none", hasdata: true}
      : {min: 0, max: Infinity, arb: "any", hasdata: false};
    state.min = f.min; state.max = f.max; state.arb = f.arb; state.hasdata = f.hasdata;
    state.cat = ""; state.chain = ""; state.q = "";
    document.getElementById("f-min").value = f.min || "";
    document.getElementById("f-max").value = isFinite(f.max) ? f.max : "";
    document.getElementById("f-arb").value = f.arb;
    document.getElementById("f-cat").value = "";
    document.getElementById("f-chain").value = "";
    document.getElementById("f-q").value = "";
    document.getElementById("t-hasdata").checked = f.hasdata;
    document.getElementById("preset-prospects").setAttribute("aria-pressed", which === "prospects");
    document.getElementById("preset-all").setAttribute("aria-pressed", which !== "prospects");
    render();
  }
  document.getElementById("preset-prospects").addEventListener("click", function () { preset("prospects"); });
  document.getElementById("preset-all").addEventListener("click", function () { preset("all"); });
  document.getElementById("csv").addEventListener("click", exportCsv);

  var themeBtn = document.getElementById("theme");
  themeBtn.addEventListener("click", function () {
    var dark = document.documentElement.getAttribute("data-theme") !== "light";
    document.documentElement.setAttribute("data-theme", dark ? "light" : "dark");
    themeBtn.textContent = dark ? "Dark" : "Light";
    try { localStorage.setItem("sc-theme", dark ? "light" : "dark"); } catch (e) {}
  });
  try {
    var saved = localStorage.getItem("sc-theme");
    if (saved) {
      document.documentElement.setAttribute("data-theme", saved);
      themeBtn.textContent = saved === "light" ? "Dark" : "Light";
    }
  } catch (e) {}

  var d = new Date(DATA.generated_at);
  document.getElementById("asof").textContent =
    isNaN(d) ? DATA.generated_at : d.toLocaleString(undefined,
      {year: "numeric", month: "short", day: "numeric", hour: "2-digit", minute: "2-digit"});

  render();
})();
</script>
</body>
</html>
